# 학생 목록
# - username: Identity Center 로그인 ID (대소문자 혼용 가능, 고유해야 함)
# - display_name: ABAC 태그 및 S3 버킷 prefix로 사용 (소문자, 공백 금지, 하이픈만 사용, 고유해야 함)
# - given_name / family_name: 실명
# - email: 선택 (미입력 시 username@student.local 사용)
# - budget: 선택 (미입력 시 기본값 사용)
students = [
  { username = "AliceSmith",  display_name = "alice-smith",  given_name = "Alice",  family_name = "Smith",  email = "alice@example.com",  budget = 10 },
  { username = "BobJohnson",  display_name = "bob-johnson",  given_name = "Bob",    family_name = "Johnson", email = "bob@example.com",   budget = 10 },
  { username = "CarolWilson", display_name = "carol-wilson", given_name = "Carol",  family_name = "Wilson", email = "carol@example.com",  budget = 10 },
]

# 관리자 이메일 (50%/80%/100% 알림 수신)
lab_admin_email = "instructor@example.com"
